    "lint": "eslint src",
    "build:vistas": "node scripts/compilar-vistas.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "convex": "^1.45.0",
    "molstar": "^4.18.0",
    "motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
