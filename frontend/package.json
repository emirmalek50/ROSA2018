{
  "name": "rosa-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/compilar-vistas.mjs",
    "preview": "vite preview",
    "test": "npm run build:vistas && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
