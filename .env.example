# Variables de entorno de ROSA2018. Copia este fichero a `.env` y rellena los
# valores; `.env` está en .gitignore y nunca se sube. Aquí NO va ni un valor
# real: son los nombres, para qué sirve cada uno y qué pasa si falta.
#
# Los valores por defecto arrancan en la máquina de quien desarrolla sin tocar
# nada. Lo que cambia en un servidor está marcado abajo.

# ---------------------------------------------------------------------------
# Imprescindible
# ---------------------------------------------------------------------------

# La clave del AI Gateway de Vercel. Todos los modelos salen por ahí: el
# cerebro, el juez y el de volumen. Sin esta clave ROSA2018 lanza ClaveAusente
# y no hay modelos. Nunca se pone una clave de Anthropic o de OpenAI directa:
# es una regla del proyecto, no una preferencia.
ROSA_GATEWAY_KEY=

# El extremo del gateway. Por defecto https://ai-gateway.vercel.sh/v1
ROSA_GATEWAY_URL=

# La cuenta del equipo y la HUELLA scrypt de su contraseña. Ojo: en
# ROSA_LOGIN_PASSWORD_HASH va la huella, NUNCA la contraseña en claro. Si se
# pone la contraseña, nadie puede entrar y el fallo no dice por qué.
ROSA_LOGIN_EMAIL=
ROSA_LOGIN_PASSWORD_HASH=

# El correo de quien administra (aprueba cuentas). Sin esto administra
# ROSA_LOGIN_EMAIL.
ROSA_ADMIN=

# ---------------------------------------------------------------------------
# En un servidor (no hace falta en local)
# ---------------------------------------------------------------------------

# Dónde escucha. Por defecto 127.0.0.1:8765. En un contenedor suele ser 0.0.0.0.
ROSA_HOST=
ROSA_PUERTO=

# OBLIGATORIO si el servidor escucha fuera de 127.0.0.1. Es la llave de red:
# sin ella, cualquier equipo que llegue al puerto puede arrancar corridas y
# gastar en el gateway. Va por la cabecera X-Rosa-Token, o por ?token= en el
# flujo SSE. Esto es aparte de la sesión de la persona: son dos puertas.
ROSA_TOKEN=

# Los nombres de host con los que se sirve, separados por comas. Sin comodines:
# es lo que frena el DNS rebinding cuando se escucha en 0.0.0.0.
ROSA_HOSTS=

# Dónde viven el estado y los PDF, si no es la raíz del repositorio. En un
# servidor apuntan al disco que persiste entre despliegues.
ROSA_BD=
ROSA_PDFS=

# ---------------------------------------------------------------------------
# Opcionales: sin ellas ROSA2018 arranca igual
# ---------------------------------------------------------------------------

# El espejo de lectura en Convex. Sin clave, el espejo queda apagado y ROSA2018
# funciona idéntica: SQLite es la fuente de verdad y el único escritor. Si se
# usa, que escriba UNA sola instancia; dos peleándose se borran entidades.
CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Claves de fuentes. Sin ellas se usan los cupos públicos y los conectores que
# las necesitan quedan en el catálogo como «requiere cuenta», con su motivo:
# nunca desaparecen ni se enseñan como «no hay datos».
ROSA_NCBI_KEY=
ROSA_OPENALEX_KEY=
ROSA_S2_KEY=
ROSA_EXA_KEY=
ROSA_SERPAPI_KEY=

# El correo de contacto que se manda a Crossref, Unpaywall y OpenAlex. Es
# público por diseño: lo piden para el «polite pool».
ROSA_CORREO=

# Presupuesto por defecto, en llamadas al modelo. Una iteración cuesta entre
# 120 y 250 (medido).
ROSA_PRESUPUESTO=
ROSA_PRESUPUESTO_ITERACION=

# El sandbox donde corre el código de los análisis. Necesita Docker en la
# máquina. Las imágenes por defecto son rosa-sandbox:1 y la de célula única.
ROSA_SANDBOX_IMAGEN=
ROSA_SANDBOX_IMAGEN_CELULA=

# Ajuste fino, rara vez se tocan: el tope diario de preguntas con
# herramientas (ROSA_PREGUNTAS_MAX_DIA, 40), los modelos de embeddings y de
# reordenación (ROSA_EMBEDDINGS_MODELO, ROSA_RERANK_MODELO) y la tabla de
# precios de respaldo (ROSA_PRECIOS, un JSON). ROSA_PERMITIR_LOCAL_SINTETICO=1
# deja correr el ensayo en seco sin Docker, y es solo para desarrollar.
# ROSA_DATOS y ROSA_ESTADO_REAL no se configuran aquí: la primera la pone el
# propio servidor dentro del sandbox y la segunda solo la usan los tests.

# MLflow. Las trazas de cada llamada están apagadas salvo para depurar.
ROSA_MLFLOW_URI=
ROSA_MLFLOW_UI=
ROSA_MLFLOW_TRAZAS=
